# Copy to .env. Environment variables take precedence. Never commit secrets.
FIXFORGE_HOST=127.0.0.1
FIXFORGE_PORT=8000
# Default: .fixforge in the project directory.
# FIXFORGE_DATA_DIR=C:/path/to/private/fixforge-data

# Repository inference provider. Use ollama for a local model without an API key.
FIXFORGE_INFERENCE_PROVIDER=openai
FIXFORGE_OLLAMA_MODEL=qwen3:4b
FIXFORGE_OLLAMA_TIMEOUT_SECONDS=300
# OpenAI credentials and model are used for OpenAI repairs.
OPENAI_API_KEY=
FIXFORGE_MODEL=gpt-4.1
# One model attempt per run. These bound output, selected source context and request timeout.
# They are not a dollar spending cap. Usage is recorded when the provider reports it.
FIXFORGE_MAX_OUTPUT_TOKENS=10000
FIXFORGE_MAX_CONTEXT_CHARS=90000
FIXFORGE_PROVIDER_TIMEOUT_SECONDS=90
# Server-side allowlist only; repository paths cannot be supplied by browser clients.
# FIXFORGE_REPOSITORIES={"my-api":"C:/dev/my-api"}
# Pre-pull this image into the Linux Docker engine. FixForge resolves it to a local image ID per run.
FIXFORGE_SANDBOX_IMAGE=python:3.11-slim
# Optional token for READING private GitHub issues. No write actions in v0.2.
GITHUB_TOKEN=
